#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
#include <stdlib.h>

int main() {
    int i;
    pid_t pid;

    for (i = 0; i < 3; i++) {
        pid = fork();

        if (pid < 0) {
            perror("fork");
            return 1;
        }

        if (pid == 0) {
            printf("Child %d: PID = %d, PPID = %d\n",
                   i + 1, getpid(), getppid());

            sleep(i + 1);

            printf("Child %d completed.\n", i + 1);
            exit(0);
        }
    }

    for (i = 0; i < 3; i++) {
        wait(NULL);
    }

    printf("All child processes completed.\n");

    return 0;
}
