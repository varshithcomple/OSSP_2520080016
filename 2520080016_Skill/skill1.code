#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>
int main()
{
    pid_t pid;
printf("= PROCESS ABSTRACTION DEMO =\n");
printf("Parent Process Started\n");
printf("Parent PID  : %d\n", getpid());
printf("Parent PPID : %d\n\n", getppid());
// Create a child process
pid = fork();
if (pid < 0)
{
    perror("fork failed");
    exit(1);
}
// Child process
if (pid == 0)
{
    printf("= CHILD PROCESS =\n");
    printf("Child PID  : %d\n", getpid());
    printf("Child PPID : %d\n", getppid());
printf("\nChild is executing 'ls' using exec()...\n");

// Replace child process with "ls -l"
execl("/bin/ls", "ls", "-l", NULL);

// This executes only if execl() fails
perror("execl failed");
exit(1);
}
// Parent process
else
{
    printf("= PARENT PROCESS =\n");
    printf("Parent PID : %d\n", getpid());
    printf("Child PID  : %d\n", pid);
printf("\nParent is waiting for child...\n");

// Wait for child to finish
wait(NULL);

printf("\nChild process has finished.\n");
printf("Parent process continues execution.\n");
}
printf("\nProcess %d exiting...\n", getpid());
return 0;
}
